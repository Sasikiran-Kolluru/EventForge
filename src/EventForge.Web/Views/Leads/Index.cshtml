@model IEnumerable<Lead>
@{
    ViewData["Title"] = "Leads";
}
<div class="heading"><div><div class="eyebrow">SALES PIPELINE</div><h1>Leads</h1><p class="muted">Capture event enquiries and move them toward an opportunity.</p></div><a class="button" asp-action="Create">＋ &nbsp; Add lead</a></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert">@success</div> }
<section class="panel"><div class="tools"><div><strong style="font:700 13px Manrope,sans-serif">Lead pipeline</strong><div class="panel-note" style="margin-bottom:0">@Model.Count() lead records</div></div><form class="search" asp-action="Index" method="get"><input class="input" type="search" name="search" value="@ViewData["Search"]" placeholder="Search leads" /><button class="button" type="submit">Search</button></form></div>
@if (!Model.Any()) { <div class="empty"><strong>No leads found</strong>Capture your first event enquiry to get started.</div> }
else { <div class="table-wrap"><table class="table"><thead><tr><th>Contact</th><th>Company</th><th>Event type</th><th>Budget</th><th>Priority</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var lead in Model) { <tr><td><strong>@lead.LeadName</strong><div style="margin-top:4px;color:#98a2b4;font-size:9px">@lead.Email</div></td><td>@(lead.CompanyName ?? "—")</td><td>@lead.EventType</td><td>@lead.Budget.ToString("C0")</td><td>@lead.Priority</td><td><span class="badge">@lead.Status</span></td><td><a asp-action="Edit" asp-route-id="@lead.LeadId">Edit</a></td></tr>}</tbody></table></div>}
</section>
