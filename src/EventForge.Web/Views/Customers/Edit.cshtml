@model Customer
@{
    ViewData["Title"] = "Edit customer";
}
<div class="heading"><div><div class="eyebrow">CUSTOMER DIRECTORY</div><h1>Edit customer</h1><p class="muted">Update contact details and account status.</p></div><a class="button light" asp-action="Details" asp-route-id="@Model.CustomerId">← &nbsp; Back to customer</a></div>
<section class="panel form-panel"><form asp-action="Edit" asp-route-id="@Model.CustomerId" method="post"><input asp-for="CustomerId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid">
    <div class="field"><label asp-for="CustomerName">Contact name</label><input asp-for="CustomerName" class="input" /><span asp-validation-for="CustomerName" class="error"></span></div>
    <div class="field"><label asp-for="CompanyName">Company</label><input asp-for="CompanyName" class="input" /></div>
    <div class="field"><label asp-for="Email">Email address</label><input asp-for="Email" class="input" type="email" /><span asp-validation-for="Email" class="error"></span></div>
    <div class="field"><label asp-for="Phone">Phone number</label><input asp-for="Phone" class="input" type="tel" /><span asp-validation-for="Phone" class="error"></span></div>
    <div class="field"><label asp-for="City">City</label><input asp-for="City" class="input" /></div>
    <div class="field"><label asp-for="State">State / region</label><input asp-for="State" class="input" /></div>
    <div class="field"><label asp-for="Status">Account status</label><select asp-for="Status" class="input"><option>Active</option><option>Inactive</option></select></div>
    <div class="field wide"><label asp-for="Address">Street address</label><input asp-for="Address" class="input" /></div>
</div><div class="form-actions"><button class="button" type="submit">Save changes</button><a class="button light" asp-action="Details" asp-route-id="@Model.CustomerId">Cancel</a></div></form></section>
