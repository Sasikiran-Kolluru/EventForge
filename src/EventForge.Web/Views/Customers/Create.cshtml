@model Customer
@{
    ViewData["Title"] = "Add customer";
}
<div class="heading"><div><div class="eyebrow">CUSTOMER DIRECTORY</div><h1>Add customer</h1><p class="muted">Add a new contact to your EventForge workspace.</p></div><a class="button light" asp-action="Index">← &nbsp; All customers</a></div>
<section class="panel form-panel"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid">
    <div class="field"><label asp-for="CustomerName">Contact name</label><input asp-for="CustomerName" class="input" autocomplete="name" /><span asp-validation-for="CustomerName" class="error"></span></div>
    <div class="field"><label asp-for="CompanyName">Company</label><input asp-for="CompanyName" class="input" autocomplete="organization" /></div>
    <div class="field"><label asp-for="Email">Email address</label><input asp-for="Email" class="input" type="email" autocomplete="email" /><span asp-validation-for="Email" class="error"></span></div>
    <div class="field"><label asp-for="Phone">Phone number</label><input asp-for="Phone" class="input" type="tel" autocomplete="tel" /><span asp-validation-for="Phone" class="error"></span></div>
    <div class="field"><label asp-for="City">City</label><input asp-for="City" class="input" autocomplete="address-level2" /></div>
    <div class="field"><label asp-for="State">State / region</label><input asp-for="State" class="input" autocomplete="address-level1" /></div>
    <div class="field wide"><label asp-for="Address">Street address</label><input asp-for="Address" class="input" autocomplete="street-address" /></div>
</div><div class="form-actions"><button class="button" type="submit">Save customer</button><a class="button light" asp-action="Index">Cancel</a></div></form></section>
