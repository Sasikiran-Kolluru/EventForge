@model Opportunity
@{
    ViewData["Title"] = "Edit opportunity";
}
<div class="heading"><div><div class="eyebrow">REVENUE MANAGEMENT</div><h1>Edit opportunity</h1><p class="muted">Update stage, expected value, and close date.</p></div><a class="button light" asp-action="Index">← &nbsp; Pipeline</a></div>
<section class="panel form-panel"><form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post"><partial name="_Fields" model="Model" /><div class="form-actions"><button class="button" type="submit">Save changes</button><a class="button light" asp-action="Index">Cancel</a></div></form></section>
