@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<div class="heading"><div><div class="eyebrow">ACCOUNT SECURITY</div><h1>Change password</h1><p class="muted">Use a unique password that you do not reuse on other sites.</p></div></div>
<section class="panel form-panel"><form asp-action="ChangePassword" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="field" style="margin-bottom:15px"><label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" class="input" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="error"></span></div>
    <div class="field" style="margin-bottom:15px"><label asp-for="NewPassword">New password (at least 10 characters)</label><input asp-for="NewPassword" class="input" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="error"></span></div>
    <div class="field"><label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" class="input" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="error"></span></div>
    <div class="form-actions"><button class="button" type="submit">Update password</button><a class="button light" asp-controller="Home" asp-action="Index">Cancel</a></div>
</form></section>
