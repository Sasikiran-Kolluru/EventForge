@model Vendor
@{
    ViewData["Title"] = "Add vendor";
}
<div class="heading"><div><div class="eyebrow">PARTNER DIRECTORY</div><h1>New vendor</h1><p class="muted">Add a service provider to your vendor directory.</p></div><a class="button light" asp-action="Index">← &nbsp; Vendors</a></div>
