@model EventForge.Web.Models.Event
@{
    ViewData["Title"] = "Edit event";
}
<div class="heading"><div><div class="eyebrow">EVENT OPERATIONS · @Model.EventCode</div><h1>Edit event</h1><p class="muted">Update planning details, date, and event status.</p></div><a class="button light" asp-action="Index">← &nbsp; Events</a></div>
<section class="panel form-panel"><form asp-action="Edit" asp-route-id="@Model.EventId" method="post"><partial name="_Fields" model="Model" /><div class="form-actions"><button class="button" type="submit">Save changes</button><a class="button light" asp-action="Index">Cancel</a></div></form></section>
