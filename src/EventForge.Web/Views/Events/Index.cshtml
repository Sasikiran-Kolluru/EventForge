@model IEnumerable<EventForge.Web.Models.Event>
@{
    ViewData["Title"] = "Events";
}
<div class="heading"><div><div class="eyebrow">EVENT OPERATIONS</div><h1>Events</h1><p class="muted">Plan and track live event engagements from one place.</p></div><a class="button" asp-action="Create">＋ &nbsp; Add event</a></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert">@success</div> }
<section class="panel"><div style="margin-bottom:15px"><strong style="font:700 13px Manrope,sans-serif">Event calendar</strong><div class="panel-note" style="margin-bottom:0">@Model.Count() scheduled events</div></div>
@if (!Model.Any()) { <div class="empty"><strong>Your calendar is clear</strong>Create an event to start planning your next experience.</div> }
else { <div class="table-wrap"><table class="table"><thead><tr><th>Event</th><th>Customer</th><th>Date</th><th>Venue</th><th>Budget</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.EventName</strong><div style="margin-top:4px;color:#98a2b4;font-size:9px">@item.EventCode · @item.EventType</div></td><td>@item.Customer?.CustomerName</td><td>@item.EventDate.ToString("MMM d, yyyy")</td><td>@item.Venue, @item.City</td><td>@item.Budget.ToString("C0")</td><td><span class="badge">@item.Status</span></td><td><a asp-action="Edit" asp-route-id="@item.EventId">Edit</a></td></tr>}</tbody></table></div>}
</section>
